/* ==========================================================================
ROOT VARIABLES
========================================================================== */
:root {
--primary-color: #ff8000;
--primary-hover: #e67300;

--text-main: #2d3748;
--text-light: #718096;

--bg-body: #f8fafc;
--bg-header: #ffffff;

--border-color: #e2e8f0;

--content-width: 840px;

--radius-sm: 8px;
--radius-md: 12px;
--radius-lg: 16px;

--shadow-sm: 0 2px 6px rgba(0,0,0,0.04);
--shadow-md: 0 10px 20px rgba(0,0,0,0.05);
--shadow-lg: 0 18px 50px rgba(0,0,0,0.06);
}

/* ==========================================================================
RESET & BASE
========================================================================== */

{
box-sizing: border-box;
margin: 0;
padding: 0;
}


html:focus-within {
scroll-behavior: smooth;
}

body {
font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
line-height: 1.6;
color: var(--text-main);
background-color: var(--bg-body);
display: flex;
flex-direction: column;
min-height: 100vh;
}

a {
color: var(--primary-color);
text-decoration: none;
}

a:hover {
text-decoration: underline;
}

.wrapper {
max-width: var(--content-width);
margin: 0 auto;
padding: 0 20px;
}

/* ==========================================================================
HEADER & NAV (FIX DEFINITIVO)
========================================================================== */
.site-header {
background-color: var(--bg-header);
border-top: 4px solid var(--primary-color);
border-bottom: 1px solid var(--border-color);
position: sticky;
top: 0;
z-index: 100;
box-shadow: var(--shadow-sm);
}

.header-wrapper {
display: flex;
justify-content: space-between;
align-items: center;
height: 70px;
gap: 20px;
}

.site-title {
font-size: 1.4rem;
font-weight: 700;
color: #1a202c;
}

.site-title:hover {
color: var(--primary-color);
text-decoration: none;
}

/* NAV PRINCIPALE */
.site-nav {
display: flex;
align-items: center;
}

.site-nav .trigger {
display: flex;
align-items: center;
gap: 22px;
flex-wrap: wrap;
}

.site-nav a {
color: var(--text-main);
font-weight: 500;
font-size: 1rem;
transition: color .2s ease;
}

.site-nav a:hover {
color: var(--primary-color);
text-decoration: none;
}

/* CTA (Babbel / money page) /
.site-nav a[href="babbel"],
.site-nav a[href*="recensione"],
.site-nav a:last-child {
color: #d97706;
font-weight: 800;
padding: 6px 12px;
border-radius: 999px;
border: 1px solid rgba(217,119,6,0.3);
background: rgba(217,119,6,0.05);
}

.site-nav a[href*="babbel"]:hover,
.site-nav a:last-child:hover {
background: rgba(217,119,6,0.12);
}

/* DISABILITA HAMBURGER (BUG ORIGINARIO) */
.nav-trigger,
.menu-icon {
display: none !important;
}

/* ==========================================================================
LAYOUT PRINCIPALE
========================================================================== */
.page-content {
flex: 1;
padding: 50px 0;
}

.post-wrapper {
max-width: 760px;
margin: 0 auto;
background: #fff;
padding: 40px;
border-radius: var(--radius-md);
box-shadow: var(--shadow-sm);
}

/* ==========================================================================
TIPOGRAFIA ARTICOLI
========================================================================== */
.post-title {
font-size: 2.4rem;
line-height: 1.2;
color: #1a202c;
margin-bottom: 10px;
}

.post-content h2 {
font-size: 1.8rem;
margin: 2em 0 .8em;
border-bottom: 2px solid var(--primary-color);
display: inline-block;
padding-bottom: 5px;
}

.post-content p {
margin-bottom: 1.2em;
font-size: 1.08rem;
}

/* ==========================================================================
CTA BUTTONS
========================================================================== */
.btn-primary {
display: inline-block;
background: var(--primary-color);
color: #fff;
padding: 15px 35px;
font-weight: 800;
border-radius: 50px;
transition: .3s;
}

.btn-primary:hover {
background: var(--primary-hover);
transform: translateY(-2px);
}

/* ==========================================================================
CONVERSION BLOCKS (CORE FUNNEL)
========================================================================== */
.tldr-box {
background: #f1f5f9;
border-left: 4px solid var(--text-light);
padding: 16px 20px;
margin-bottom: 30px;
}

.bridge-box {
margin: 40px 0;
padding: 24px;
background: #f8fafc;
border-left: 5px solid var(--primary-color);
}

.promo-box {
margin: 45px 0;
padding: 30px;
border: 2px solid var(--primary-color);
border-radius: var(--radius-md);
text-align: center;
background: linear-gradient(180deg, rgba(255,128,0,.08), #fff);
}

.trust-box {
margin: 40px 0;
padding: 24px;
border: 1px solid var(--border-color);
background: #fff;
}

.orient-box {
margin: 50px 0;
padding: 35px 25px;
background: #1a202c;
color: #fff;
text-align: center;
border-radius: var(--radius-md);
}

/* ==========================================================================
SECTION UX BLOCK
========================================================================== */
.section-in-breve {
background: #f8fafc;
border-left: 4px solid #3b82f6;
padding: 24px;
margin: 32px 0;
border-radius: 0 8px 8px 0;
}

/* ==========================================================================
FOOTER
========================================================================== */
.site-footer {
background: #1a202c;
color: #cbd5e1;
padding: 50px 0 20px;
}

/* ==========================================================================
MOBILE (FIX NAV DEFINITIVO)
========================================================================== */
@media (max-width: 768px) {

.header-wrapper {
flex-direction: column;
align-items: flex-start;
gap: 10px;
height: auto;
padding: 12px 0;
}

.site-nav {
width: 100%;
}

.site-nav .trigger {
display: flex;
flex-wrap: wrap;
gap: 10px;
align-items: center;
width: 100%;
}

/* 🔥 IMPORTANTE: NON full width */
.site-nav a {
width: auto;
display: inline-block;
padding: 6px 10px;
border: 1px solid rgba(226,232,240,0.8);
border-radius: 999px;
font-size: 0.9rem;
}

/* CTA più visibile ma NON gigante /
.site-nav a[href="babbel"],
.site-nav a:last-child {
background: rgba(217,119,6,0.08);
border-color: rgba(217,119,6,0.3);
}

}
