def load_cache():
    cache_file = "_cache.json"

    if not os.path.exists(cache_file):
        return {}

    try:
        with open(cache_file, "r", encoding="utf-8") as f:
            content = f.read().strip()

            if not content:
                return {}

            return json.loads(content)

    except json.JSONDecodeError:
        # cache corrotta → reset automatico
        return {}

    except Exception:
        return {}
